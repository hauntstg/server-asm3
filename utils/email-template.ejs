<div
  style="
    background-color: #222;
    color: white;
    padding: 20px;
    font-family: sans-serif;
  "
>
  <h2>Xin Chào <%= fullname %></h2>
  <p><strong>Phone:</strong> <%= phone %></p>
  <p><strong>Address:</strong><%= address %></p>

  <table
    border="1"
    cellpadding="10"
    cellspacing="0"
    style="margin-top: 20px; width: 100%; text-align: center"
  >
    <thead>
      <tr>
        <th>Tên Sản Phẩm</th>
        <th>Hình Ảnh</th>
        <th>Giá</th>
        <th>Số Lượng</th>
        <th>Thành Tiền</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(item => { %>
      <tr>
        <td><%= item.productId.name %></td>
        <td>
          <img src="<%= item.productId.img1 %>" alt="img" style="width: 50px" />
        </td>
        <td><%= item.productId.price.toLocaleString() %> VND</td>
        <td><%= item.quantity %></td>
        <td>
          <%= (item.productId.price * item.quantity).toLocaleString() %> VND
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <h2 style="margin-top: 30px">
    Tổng Thanh Toán:<br />
    <%= total_price.toLocaleString() %> VND
  </h2>

  <h2 style="margin-top: 20px">Cảm ơn bạn!</h2>
</div>
